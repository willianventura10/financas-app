rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Cada usuário lê e grava apenas o que está debaixo do próprio identificador.
    match /users/{uid}/{documento=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
      // Conta de consulta: lê os dados do dono indicado em leitores/{uid dela}, sem gravar.
      allow read: if request.auth != null
        && exists(/databases/$(database)/documents/leitores/$(request.auth.uid))
        && get(/databases/$(database)/documents/leitores/$(request.auth.uid)).data.dono == uid;
    }

    // Quem pode consultar os dados de quem. Criado só pelo painel do Firebase: o app lê, nunca grava.
    match /leitores/{leitor} {
      allow read: if request.auth != null && request.auth.uid == leitor;
    }
  }
}
